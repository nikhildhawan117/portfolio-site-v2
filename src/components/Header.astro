---
---

<header class="header">
	<nav class="nav-container">
		<a href="/" class="logo">
			Nikhil Dhawan
		</a>
		<div class="nav-links">
			<a href="/#bio" class="nav-link">About</a>
			<a href="/#publications" class="nav-link">Publications</a>
			<a href="/#projects" class="nav-link">Projects</a>
			<a href="/#timeline" class="nav-link">Timeline</a>
			<a href="/gallery" class="nav-link">Photos</a>
			<a href="/resume" class="nav-link">Resume</a>
			<button id="theme-toggle" class="theme-btn" aria-label="Toggle theme">
				<span id="theme-icon" class="theme-icon">
					<!-- Sun icon (light mode) -->
					<svg id="sun-icon" class="icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="12" cy="12" r="5"></circle>
						<line x1="12" y1="1" x2="12" y2="3"></line>
						<line x1="12" y1="21" x2="12" y2="23"></line>
						<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
						<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
						<line x1="1" y1="12" x2="3" y2="12"></line>
						<line x1="21" y1="12" x2="23" y2="12"></line>
						<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
						<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
					</svg>
					<!-- Crescent moon icon (dark mode) -->
					<svg id="moon-icon" class="icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
					</svg>
				</span>
			</button>
		</div>
	</nav>
</header>

<script>
	const themeIcon = document.getElementById('theme-icon');
	const sunIcon = document.getElementById('sun-icon');
	const moonIcon = document.getElementById('moon-icon');
	const html = document.documentElement;
	const themeBtn = document.getElementById('theme-toggle');
	
	let isAnimating = false;
	
	function updateThemeIcon(animate = false) {
		if (isAnimating) return;
		
		const currentTheme = html.getAttribute('data-theme');
		
		if (animate) {
			isAnimating = true;
			themeIcon.classList.add('animating');
			
			if (currentTheme === 'light') {
				// Transitioning to dark: sun spins, then crescent appears
				themeIcon.classList.add('to-dark');
				setTimeout(() => {
					sunIcon.style.display = 'none';
					moonIcon.style.display = 'block';
					themeIcon.classList.remove('to-dark');
					themeIcon.classList.add('moon-enter');
					setTimeout(() => {
						themeIcon.classList.remove('moon-enter', 'animating');
						themeIcon.style.willChange = 'auto';
						isAnimating = false;
					}, 350);
				}, 150);
			} else {
				// Transitioning to light: moon spins, then sun appears
				themeIcon.classList.add('to-light');
				setTimeout(() => {
					moonIcon.style.display = 'none';
					sunIcon.style.display = 'block';
					themeIcon.classList.remove('to-light');
					themeIcon.classList.add('sun-enter');
					setTimeout(() => {
						themeIcon.classList.remove('sun-enter', 'animating');
						themeIcon.style.willChange = 'auto';
						isAnimating = false;
					}, 350);
				}, 150);
			}
		} else {
			// Initial load - no animation
			if (currentTheme === 'light') {
				sunIcon.style.display = 'block';
				moonIcon.style.display = 'none';
			} else {
				sunIcon.style.display = 'none';
				moonIcon.style.display = 'block';
			}
		}
	}
	
	// Initial icon update
	updateThemeIcon();
	
	// Watch for theme changes
	const observer = new MutationObserver(() => {
		updateThemeIcon(true);
	});
	observer.observe(html, { attributes: true, attributeFilter: ['data-theme'] });
	
	// Handle button click
	if (themeBtn) {
		themeBtn.addEventListener('click', () => {
			const currentTheme = html.getAttribute('data-theme');
			const newTheme = currentTheme === 'light' ? 'dark' : 'light';
			html.setAttribute('data-theme', newTheme);
			localStorage.setItem('theme', newTheme);
		});
	}
</script>

<style is:global>
	.header {
		position: sticky;
		top: 0;
		z-index: 100;
		border-bottom: 1px solid var(--border);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
	}

	[data-theme="light"] .header {
		background-color: rgba(253, 251, 247, 0.92);
		transition: background-color 0.1s ease-out;
	}

	[data-theme="dark"] .header {
		background-color: rgba(28, 26, 23, 0.92);
		transition: background-color 0.1s ease-out;
	}

	.nav-container {
		max-width: 1100px;
		margin: 0 auto;
		padding: 1.25rem 4rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	@media (max-width: 1024px) {
		.nav-container {
			padding: 1.25rem 3rem;
		}
	}

	@media (max-width: 900px) {
		.nav-container {
			padding: 1.25rem 2.5rem;
		}
	}

	.logo {
		font-family: 'Fraunces', Georgia, serif;
		font-size: 1.25rem;
		font-weight: 500;
		color: var(--text-primary);
		letter-spacing: -0.02em;
		text-decoration: none !important;
	}

	.logo:hover {
		color: var(--accent);
	}

	.nav-links {
		display: flex;
		gap: 2.5rem;
		align-items: center;
	}

	.nav-link {
		font-size: 0.9rem;
		font-weight: 400;
		color: var(--text-secondary);
		letter-spacing: 0.01em;
		text-decoration: none !important;
	}

	.nav-link:hover {
		color: var(--text-primary);
	}

	.theme-btn {
		width: 36px;
		height: 36px;
		border-radius: 50%;
		background: var(--bg-secondary);
		color: var(--text-primary);
		display: flex;
		align-items: center;
		justify-content: center;
		transition: background-color 0.2s ease, opacity 0.2s ease;
		border: none;
		cursor: pointer;
		position: relative;
	}

	.theme-btn:hover {
		background: var(--bg-tertiary);
		opacity: 0.8;
	}

	.theme-icon {
		position: relative;
		width: 18px;
		height: 18px;
		transition: transform 0.2s ease;
		display: flex;
		align-items: center;
		justify-content: center;
		will-change: transform;
	}

	.theme-icon .icon {
		position: absolute;
		width: 18px;
		height: 18px;
		transition: opacity 0.2s ease;
	}

	/* Animation: Sun spinning out */
	.theme-icon.animating.to-dark {
		animation: spinOut 0.25s ease-out;
		will-change: transform, opacity;
	}

	/* Animation: Moon entering (starts upside down top-right, rotates to bottom-right, then reverses) */
	.theme-icon.moon-enter {
		animation: moonEnter 0.35s cubic-bezier(0.4, 0, 0.2, 1);
		will-change: transform, opacity;
	}

	/* Animation: Moon spinning out */
	.theme-icon.animating.to-light {
		animation: spinOut 0.25s ease-out;
		will-change: transform, opacity;
	}

	/* Animation: Sun entering */
	.theme-icon.sun-enter {
		animation: sunEnter 0.35s ease-out;
		will-change: transform, opacity;
	}

	@keyframes spinOut {
		0% {
			transform: rotate(0deg);
			opacity: 1;
		}
		100% {
			transform: rotate(180deg);
			opacity: 0;
		}
	}

	@keyframes moonEnter {
		0% {
			transform: rotate(-135deg) scale(0.8);
			opacity: 0;
		}
		60% {
			transform: rotate(45deg) scale(1.1);
			opacity: 1;
		}
		100% {
			transform: rotate(0deg) scale(1);
			opacity: 1;
		}
	}

	@keyframes sunEnter {
		0% {
			transform: rotate(180deg) scale(0.8);
			opacity: 0;
		}
		50% {
			transform: rotate(90deg) scale(1.1);
			opacity: 1;
		}
		100% {
			transform: rotate(0deg) scale(1);
			opacity: 1;
		}
	}

	@media (max-width: 768px) {
		.nav-container {
			flex-direction: column;
			gap: 1.25rem;
			padding: 1rem 1.5rem;
		}
		
		.nav-links {
			flex-wrap: wrap;
			justify-content: center;
			gap: 1.25rem;
		}
	}

	@media (max-width: 480px) {
		.nav-container {
			padding: 1rem 1rem;
		}

		.nav-links {
			gap: 1rem;
			font-size: 0.85rem;
		}

		.logo {
			font-size: 1.1rem;
		}
	}
</style>
