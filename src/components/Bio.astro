---
const interests = [
	"Reinforcement Learning",
	"Agentic Software Engineering",
	"Large Language Models",
	"Machine Learning",
	"Causal Inference",
	"Econometrics",
	"Evidence-Based Medicine",
];
---

<section id="bio" class="section">
	<div class="bio-container">
		<div class="bio-image-wrapper">
			<img 
				src="/images/pictures of nikhil/me_in_front_of_deep_mind_logo_london.jpeg" 
				alt="Nikhil Dhawan" 
				class="bio-image"
			/>
			<div class="interests">
				<p class="interests-label">Research Interests</p>
				<div class="interests-list">
					{interests.map((interest) => (
						<span class="interest-tag">{interest}</span>
					))}
				</div>
				<div class="social-links">
					<a href="https://linkedin.com/in/nd353" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="LinkedIn">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
							<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
						</svg>
					</a>
					<a href="https://github.com/nikhildhawan117" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="GitHub">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
							<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
						</svg>
					</a>
				</div>
			</div>
		</div>
		<div class="bio-content">
			<p class="greeting">Hello, I'm</p>
			<h1>Nikhil Dhawan</h1>
			<p class="role">Senior Researcher at Google DeepMind</p>
			<div class="bio-text">
				<p>
					I'm currently a researcher at <a href="https://deepmind.google/" target="_blank" rel="noopener">Google DeepMind</a> working on reinforcement learning and post-training to improve Gemini's coding & software engineering capabilities.
				</p>
				<p>
					Prior to DeepMind, I was a software engineer at <a href="https://www.google.com" target="_blank" rel="noopener">Google</a> working on ads optimization and recommendations. Before that, I was a software engineer and data scientist at <a href="https://microsoft.com" target="_blank" rel="noopener">Microsoft</a>, working on research economics and machine learning problems related to <a href="https://azure.microsoft.com" target="_blank" rel="noopener">Microsoft Azure</a>. During my time there, I had the great fortune of working with and reporting to the Senior Director of Economics in Azure, <a href="https://patrickhummelecon.github.io/" target="_blank" rel="noopener">Patrick Hummel</a>. I've also previously interned at <a href="https://www.blackstone.com" target="_blank" rel="noopener">The Blackstone Group</a> and as a researcher at <a href="https://tech.cornell.edu" target="_blank" rel="noopener">Cornell Tech</a>.
				</p>
				<p>
					I attended <a href="https://www.cornell.edu" target="_blank" rel="noopener">Cornell University</a> from 2015–2019 where I studied Computer Science, Electrical Engineering, and Business. While at Cornell, I was an undergraduate researcher in the <a href="https://hrc2.io" target="_blank" rel="noopener">Human Robot Collaboration and Companionship Lab</a> under the supervision of <a href="http://www.guyhoffman.com" target="_blank" rel="noopener">Guy Hoffman</a>. My research focused on studying side-by-side collaborative design between humans and intelligent agents, and I co-authored several publications including one which won Best Paper at the 2018 Design Computing and Cognition conference.
				</p>
				<p>
					I live in New York City and grew up in the <a href="https://en.wikipedia.org/wiki/Hudson_Valley"  target="_blank" rel="noopener">Hudson Valley</a>. I also enjoy cooking—I've even taken classes at the <a href="https://www.culinaryinstituteamerica.edu/" target="_blank" rel="noopener">Culinary Institute of America</a>—lifting weights, and eating dinner at <a href="https://www.donangie.com/"  target="_blank" rel="noopener">Don Angie</a>.
				</p>
			</div>
			<div class="bio-images">
				<img 
					src="/images/pictures of nikhil/me_and_friend_nyc_skyline.jpeg" 
					alt="NYC Skyline" 
					class="bio-thumbnail"
				/>
				<img 
					src="/images/pictures of nikhil/me_cooking_with_turkey.jpeg" 
					alt="Cooking" 
					class="bio-thumbnail bio-thumbnail-turkey"
				/>
				<img 
					src="/images/pictures of nikhil/me_in_san_diego_sunset_breathtaking.jpeg" 
					alt="San Diego Sunset" 
					class="bio-thumbnail"
				/>
				<img 
					src="/images/other pics/don_angie.jpeg" 
					alt="Don Angie" 
					class="bio-thumbnail"
				/>
			</div>
		</div>
	</div>
</section>

<style>
	.bio-container {
		max-width: 1000px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 280px 1fr;
		gap: 4rem;
		align-items: start;
		width: 100%;
	}

	.bio-image-wrapper {
		position: sticky;
		top: 120px;
	}

	.bio-image {
		width: 100%;
		border-radius: 8px;
		box-shadow: var(--shadow);
	}

	.interests {
		margin-top: 1.5rem;
	}

	.interests-label {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-muted);
		margin-bottom: 0.75rem;
		font-weight: 500;
	}

	.interests-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.interest-tag {
		padding: 0.3rem 0.7rem;
		background-color: var(--bg-secondary);
		border-radius: 100px;
		font-size: 0.75rem;
		color: var(--text-secondary);
		font-weight: 500;
	}

	.social-links {
		display: flex;
		gap: 1rem;
		margin-top: 1.25rem;
	}

	.social-link {
		display: inline-flex;
		align-items: center;
		color: var(--text-muted);
		transition: color 0.2s ease, transform 0.2s ease;
	}

	.social-link:hover {
		color: var(--accent);
		transform: translateY(-2px);
	}

	.social-link svg {
		width: 20px;
		height: 20px;
	}

	.greeting {
		font-size: 0.95rem;
		color: var(--accent);
		margin-bottom: 0.5rem;
		font-weight: 500;
		letter-spacing: 0.02em;
	}

	.role {
		font-size: 1.1rem;
		color: var(--text-muted);
		margin-bottom: 2rem;
		font-weight: 400;
	}

	.bio-text {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.bio-text p {
		font-size: 1.05rem;
		line-height: 1.8;
		color: var(--text-secondary);
	}

	.bio-text a {
		color: var(--accent);
		font-weight: 500;
		text-decoration: none;
	}

	.bio-text a:hover {
		color: var(--accent-hover);
		text-decoration: none;
	}

	.bio-images {
		display: flex;
		gap: 1rem;
		margin-top: 2.5rem;
	}

	.bio-thumbnail {
		width: 180px;
		height: 150px;
		object-fit: cover;
		object-position: center;
		border-radius: 6px;
		box-shadow: var(--shadow);
		transition: transform 0.2s ease-out, box-shadow 0.2s ease-out;
		will-change: transform;
	}

	.bio-thumbnail-turkey {
		object-position: top center;
	}

	.bio-thumbnail:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-hover);
	}

	@media (max-width: 1024px) {
		.bio-container {
			gap: 3rem;
		}
	}

	@media (max-width: 900px) {
		.bio-container {
			grid-template-columns: 220px 1fr;
			gap: 2.5rem;
		}

		.bio-image-wrapper {
			position: static;
		}
	}

	@media (max-width: 768px) {
		.bio-container {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.bio-image-wrapper {
			position: static;
			max-width: 220px;
			margin: 0 auto 2rem;
		}

		.interests {
			text-align: center;
		}

		.interests-list {
			justify-content: center;
		}

		.social-links {
			justify-content: center;
		}

		.bio-images {
			flex-wrap: wrap;
			justify-content: center;
			gap: 0.75rem;
		}

		.bio-thumbnail {
			width: calc(50% - 0.375rem);
			max-width: 160px;
			height: 120px;
		}

		.bio-thumbnail-turkey {
			object-position: top center;
		}

		.greeting {
			text-align: center;
		}

		.role {
			text-align: center;
		}
	}

	@media (max-width: 640px) {
		.bio-container {
			gap: 1.5rem;
		}

		.bio-image-wrapper {
			max-width: 180px;
		}

		.bio-text p {
			font-size: 1rem;
			line-height: 1.7;
		}
	}

	@media (max-width: 480px) {
		.bio-images {
			gap: 0.5rem;
		}

		.bio-thumbnail {
			width: calc(50% - 0.25rem);
			max-width: 140px;
			height: 100px;
		}

		.bio-text p {
			font-size: 0.95rem;
		}

		.interests-label {
			font-size: 0.75rem;
		}

		.interest-tag {
			font-size: 0.7rem;
			padding: 0.25rem 0.6rem;
		}
	}
</style>
