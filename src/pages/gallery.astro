---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';

const images = [
	{ src: "/images/pictures of nikhil/me_and_friend_nyc_skyline.jpeg", alt: "NYC Skyline" },
	{ src: "/images/pictures of nikhil/me_cooking_with_turkey.jpeg", alt: "Cooking", isTurkey: true },
	{ src: "/images/pictures of nikhil/me_curling.jpeg", alt: "Curling" },
	{ src: "/images/pictures of nikhil/me_hiking_in_joshua_tree.jpeg", alt: "Joshua Tree" },
	{ src: "/images/pictures of nikhil/me_in_front_of_deep_mind_logo_london.jpeg", alt: "DeepMind London" },
	{ src: "/images/pictures of nikhil/me_in_nottinghill_bookstore.jpeg", alt: "Notting Hill" },
	{ src: "/images/pictures of nikhil/me_in_san_diego_sunset_breathtaking.jpeg", alt: "San Diego Sunset" },
	{ src: "/images/pictures of nikhil/me_out_in_soho_with_champagne.jpeg", alt: "Soho" },
	{ src: "/images/pictures of nikhil/me_shopping_with_margiela_bag.jpeg", alt: "Margiela" }
];
---

<BaseLayout title="Photos — Nikhil Dhawan">
	<Header />
	<main>
		<section class="section">
			<div class="container">
				<h1 class="gallery-title" style="padding-bottom: 1.5rem;">Some Pictures of Me</h1>
				<div class="gallery-grid">
					{images.map((image) => (
						<div class="gallery-item">
							<img 
								src={image.src} 
								alt={image.alt}
								class={image.isTurkey ? "gallery-img gallery-img-turkey" : "gallery-img"}
								loading="lazy"
							/>
							<div class="gallery-overlay">
								<span>{image.alt}</span>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.gallery-title {
		text-align: center;
		margin-bottom: 0.5rem;
	}

	.gallery-subtitle {
		text-align: center;
		color: var(--text-muted);
		margin-bottom: 3rem;
	}

	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}

	.gallery-item {
		position: relative;
		overflow: hidden;
		border-radius: 8px;
		aspect-ratio: 4/3;
		cursor: pointer;
		will-change: transform;
	}

	.gallery-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		transition: transform 0.25s ease-out;
		will-change: transform;
	}

	.gallery-img-turkey {
		object-position: top center;
	}

	.gallery-item:hover .gallery-img {
		transform: scale(1.05);
	}

	.gallery-overlay {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		padding: 1.5rem 1rem;
		background: linear-gradient(transparent, rgba(0,0,0,0.7));
		color: white;
		font-size: 0.9rem;
		font-weight: 500;
		opacity: 0;
		transition: opacity 0.1s ease;
		pointer-events: none;
	}

	.gallery-item:hover .gallery-overlay {
		opacity: 1;
	}

	@media (max-width: 900px) {
		.gallery-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.gallery-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	// Simple lightbox functionality
	document.querySelectorAll('.gallery-img').forEach(img => {
		img.addEventListener('click', () => {
			const lightbox = document.createElement('div');
			lightbox.style.cssText = `
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background-color: rgba(0, 0, 0, 0.92);
				display: flex;
				align-items: center;
				justify-content: center;
				z-index: 1000;
				cursor: pointer;
				animation: fadeIn 0.3s ease;
			`;
			
			const lightboxImg = document.createElement('img');
			lightboxImg.src = (img as HTMLImageElement).src;
			lightboxImg.style.cssText = `
				max-width: 90%;
				max-height: 90%;
				object-fit: contain;
				border-radius: 4px;
				animation: scaleIn 0.3s ease;
			`;
			
			lightbox.appendChild(lightboxImg);
			document.body.appendChild(lightbox);
			document.body.style.overflow = 'hidden';
			
			lightbox.addEventListener('click', () => {
				document.body.removeChild(lightbox);
				document.body.style.overflow = '';
			});
		});
	});
</script>
