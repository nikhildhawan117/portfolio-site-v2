---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---

<BaseLayout title="Resume — Nikhil Dhawan">
	<Header />
	<main>
		<section class="section resume-section">
			<div class="container resume-container">
				<h1>Resume</h1>
				<p class="resume-subtitle">View or download the PDF.</p>
				<div class="resume-actions">
					<a href="/resume.pdf" class="resume-link" target="_blank" rel="noopener noreferrer">Open PDF</a>
					<a href="/resume.pdf" class="resume-link" download>Download PDF</a>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.resume-section {
		padding-top: 3rem;
		padding-bottom: 3rem;
	}

	.resume-container {
		max-width: 640px;
		text-align: center;
	}

	h1 {
		margin-bottom: 1rem;
	}

	.resume-subtitle {
		color: var(--text-muted);
		margin-bottom: 2rem;
		line-height: 1.6;
	}

	.resume-actions {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.resume-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.85rem 1.5rem;
		background-color: var(--accent);
		color: white;
		border-radius: 6px;
		font-weight: 500;
		text-decoration: none;
		transition: background-color 0.2s ease, transform 0.2s ease;
	}

	.resume-link:hover {
		background-color: var(--accent-hover);
		transform: translateY(-2px);
		color: white;
	}

	@media (max-width: 480px) {
		.resume-actions {
			flex-direction: column;
		}
	}
</style>
